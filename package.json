{
    "name": "cellestial",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "dev": "turbo watch dev",
        "dev:pwa": "bun scripts/dev/pwa.ts",
        "dev:prism": "bun scripts/dev/prism.ts",
        "dev:trust-windows": "bun scripts/dev/trust-windows.ts",
        "build": "turbo run build",
        "image": "turbo run build && docker build -f apps/bff/Dockerfile -t cdd-bff:local .",
        "lint": "turbo run lint lint:scripts",
        "typecheck": "turbo run typecheck typecheck:scripts",
        "lint:scripts": "oxlint scripts",
        "typecheck:scripts": "tsc --noEmit -p scripts",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "check": "bun run fmt:check && turbo run lint lint:scripts typecheck typecheck:scripts",
        "release": "bun scripts/release/index.ts",
        "contract:fetch": "bun scripts/openapi/backend.ts fetch",
        "contract:verify": "bun scripts/openapi/backend.ts verify",
        "contract:tools": "cd spec && npm ci --no-audit --no-fund",
        "contract:lint": "cd spec && npx --no redocly lint openapi.json --config redocly.yaml",
        "orval": "orval --config orval.config.ts",
        "sync": "bun run contract:lint && bun run orval"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1146.0",
        "@cdd-team/oxlint-plugin-jsdoc": "^0.1.2",
        "@stoplight/prism-cli": "5.16.0",
        "@types/bun": "^1.4.4",
        "lefthook": "^2.2.2",
        "orval": "^8.44.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "turbo": "^2.11.7",
        "typescript": "^7.0.2"
    },
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22.19.0"
    },
    "packageManager": "bun@1.4.4"
}
