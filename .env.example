# Свой локальный Go. Для HTTPS задайте все три файла TLS.
IDENTITY_API_URL=http://127.0.0.1:8081/api/v1
WORKSPACE_API_URL=http://127.0.0.1:8082/api/v1
BFF_KEY=
GO_API_TLS_CA_FILE=
GO_API_TLS_CERT_FILE=
GO_API_TLS_KEY_FILE=

# Для bun run dev:tunnel задайте SSH-алиас gateway, IP VPS2 и файлы TLS.
# Скрипт пробрасывает два порта и проверяет DNS SAN каждого API.
DEV_TUNNEL_SSH_HOST=
DEV_TUNNEL_BACKEND_HOST=
