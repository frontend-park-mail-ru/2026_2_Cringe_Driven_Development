# Свой локальный Go. Для HTTPS задайте все три файла TLS.
GO_API_URL=http://127.0.0.1:8080/api/v1
BFF_KEY=
GO_API_TLS_CA_FILE=
GO_API_TLS_CERT_FILE=
GO_API_TLS_KEY_FILE=

# Для bun run dev:tunnel задайте SSH-алиас gateway, IP VPS2 и файлы TLS.
# Скрипт сам подставит GO_API_URL и GO_API_TLS_SERVER_NAME (IP сервера за туннелем).
DEV_TUNNEL_SSH_HOST=
DEV_TUNNEL_BACKEND_HOST=
