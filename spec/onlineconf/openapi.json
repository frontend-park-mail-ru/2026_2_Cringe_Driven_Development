        ],
        "responses": {
          "201": {
            "description": "Созданный ключ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Key"
                },
                "examples": {
                  "config": {
                    "summary": "config",
                    "value": {
                      "scope": "frontend",
                      "name": "editor.theme",
                      "kind": "config",
                      "value": {
                        "default": "dark",
                        "allowed": [
                          "dark",
                          "light"
                        ]
                      }
                    }
                  },
                  "flag": {
                    "summary": "flag",
                    "value": {
                      "scope": "workspace",
                      "name": "notebook.comments",
                      "kind": "flag",
                      "rollout_percent": 25,
                      "include_user_ids": [
                        1,
                        7
                      ],
                      "exclude_user_ids": [
                        42
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Тело или параметры не прошли проверку: неизвестное поле, имя или scope вне формата, процент вне 0..100, повтор ID или пересечение списков. Ничего не сохраняется.",
