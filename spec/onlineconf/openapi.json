{
  "openapi": "3.1.0",
  "info": {
    "title": "Cellestial OnlineConf API",
    "version": "1.0.0",
    "description": "Внутренний административный HTTP API OnlineConf. Пути от корня сервиса, без /api/v1. Все операции требуют mTLS с идентичностью BFF, X-BFF-Key и access-токен пользователя с ролью onlineconf_admin из Identity. Ключ однозначно задают scope и имя; вид ключа (config или flag) после создания не меняется."
  },
  "tags": [
    {
      "name": "admin",
      "description": "Проверка доступа и управление ключами OnlineConf."
    }
  ],
  "security": [],
  "paths": {
    "/admin/access": {
      "get": {
        "summary": "Проверка доступа",
        "description": "Подтверждает, что текущий пользователь может работать с OnlineConf. Требуются X-BFF-Key и Authorization: Bearer <access_token> пользователя с ролью onlineconf_admin; порядок проверки: S2S → Bearer → роль → валидация.",
        "operationId": "getAdminAccess",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-BFF-Key",
            "in": "header",
            "required": true,
            "example": "<bff-key>",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Общий секрет BFF и OnlineConf. Проверяется до Bearer, разбора тела и валидации. Отсутствующий, неверный или повторяющийся заголовок: 403 s2s_forbidden."
          }
        ],
        "responses": {
          "204": {
            "description": "Пользователь с ролью onlineconf_admin."
          },
          "401": {
            "description": "Access-токен отсутствует, истёк или сессия отозвана.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "authentication required"
                }
              }
            }
          },
          "403": {
            "description": "X-BFF-Key отсутствует или неверен (s2s_forbidden) либо у пользователя нет роли onlineconf_admin (forbidden). Проверка ключа выполняется первой.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "s2s": {
                    "summary": "s2s",
                    "value": {
                      "code": "s2s_forbidden",
                      "message": "service access forbidden"
                    }
                  },
                  "role": {
                    "summary": "role",
                    "value": {
                      "code": "forbidden",
                      "message": "onlineconf_admin role required"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "internal",
                  "message": "internal error"
                }
              }
            }
          },
          "503": {
            "description": "Identity или хранилище OnlineConf недоступны.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "dependency_unavailable",
                  "message": "authorization unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/admin/keys": {
      "get": {
        "summary": "Ключи scope",
        "description": "Ключи одного scope, отсортированные по имени. Ключи других scope не возвращаются. shortcut: без пагинации, ответ ограничен 500 ключами; курсор — когда scope перерастёт лимит. Требуются X-BFF-Key и Authorization: Bearer <access_token> пользователя с ролью onlineconf_admin; порядок проверки: S2S → Bearer → роль → валидация.",
        "operationId": "listKeys",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-BFF-Key",
            "in": "header",
            "required": true,
            "example": "<bff-key>",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Общий секрет BFF и OnlineConf. Проверяется до Bearer, разбора тела и валидации. Отсутствующий, неверный или повторяющийся заголовок: 403 s2s_forbidden."
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Scope"
            },
            "example": "frontend"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Подстрока имени без учёта регистра; пробелы по краям обрезаются, пустая строка — весь scope.",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "example": "editor"
          }
        ],
        "responses": {
          "200": {
            "description": "Ключи scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyList"
                },
                "example": {
                  "items": [
                    {
                      "scope": "frontend",
                      "name": "editor.theme",
                      "kind": "config"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Тело или параметры не прошли проверку: неизвестное поле, имя или scope вне формата, процент вне 0..100, повтор ID или пересечение списков. Ничего не сохраняется.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "validation_error",
                  "message": "include_user_ids and exclude_user_ids intersect"
                }
              }
            }
          },
          "401": {
            "description": "Access-токен отсутствует, истёк или сессия отозвана.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "authentication required"
                }
              }
            }
          },
          "403": {
            "description": "X-BFF-Key отсутствует или неверен (s2s_forbidden) либо у пользователя нет роли onlineconf_admin (forbidden). Проверка ключа выполняется первой.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "s2s": {
                    "summary": "s2s",
                    "value": {
                      "code": "s2s_forbidden",
                      "message": "service access forbidden"
                    }
                  },
                  "role": {
                    "summary": "role",
                    "value": {
                      "code": "forbidden",
                      "message": "onlineconf_admin role required"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка сервиса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "internal",
                  "message": "internal error"
                }
              }
            }
          },
          "503": {
            "description": "Identity или хранилище OnlineConf недоступны.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "dependency_unavailable",
                  "message": "authorization unavailable"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Создать ключ",
        "description": "Создаёт конфиг или флаг. При любой ошибке проверки ключ не создаётся. Требуются X-BFF-Key и Authorization: Bearer <access_token> пользователя с ролью onlineconf_admin; порядок проверки: S2S → Bearer → роль → валидация.",
        "operationId": "createKey",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
