{
  "openapi": "3.1.0",
  "info": {
    "title": "Cellestial OnlineConf API",
    "version": "1.0.0",
    "description": "Внутренний административный HTTP API OnlineConf. Пути заданы от корня сервиса. Межсервисное подключение использует mTLS. Сервис проверяет X-BFF-Key, затем пользовательский Bearer-токен и роль onlineconf_admin в Identity, затем параметры и тело запроса. Продуктовый метод /api/v1/onlineconf/me роли не требует (backend#158)."
  },
  "tags": [
    {
      "name": "admin",
      "description": "Проверка доступа и управление ключами OnlineConf."
    },
    {
      "name": "product",
      "description": "Публичные настройки продукта для пользователя текущей сессии (backend#158)."
    }
  ],
  "security": [
    {
      "bffKey": [],
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/access": {
      "get": {
        "summary": "Проверить административный доступ",
        "operationId": "getAdminAccess",
        "tags": [
          "admin"
        ],
        "responses": {
          "204": {
            "description": "Пользователь с ролью onlineconf_admin."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AuthorizationUnavailable"
          }
        }
      }
    },
    "/admin/keys": {
      "get": {
        "summary": "Получить список ключей",
        "operationId": "listKeys",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Отфильтрованные ключи и общие счётчики.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyList"
                },
                "example": {
                  "items": [
                    {
                      "name": "frontend.banner",
                      "scope": "frontend",
                      "type": "config",
                      "value": false,
                      "updated_at": "2026-11-28T10:00:00Z"
                    },
                    {
                      "name": "workspace.calendar",
                      "scope": "workspace",
                      "type": "flag",
                      "enabled": true,
                      "rollout_percent": 25,
                      "updated_at": "2026-11-28T10:00:00Z"
                    }
                  ],
                  "total_count": 2,
                  "scope_count": 2,
                  "scopes": [
                    "frontend",
                    "bff",
                    "identity",
                    "workspace"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/AuthorizationUnavailable"
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Подстрока полного имени без учёта регистра. Пробельные символы по краям удаляются.",
            "schema": {
              "type": "string"
            },
            "example": "calendar"
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Фильтр по области. Для всех областей опустите параметр.",
            "schema": {
              "$ref": "#/components/schemas/Scope"
            },
            "example": "workspace"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Фильтр по типу. Для обоих типов опустите параметр.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "flag"
              ]
            },
            "example": "flag"
          }
        ]
      },
      "post": {
        "summary": "Создать ключ",
        "operationId": "createKey",
        "tags": [
          "admin"
        ],
        "responses": {
          "201": {
            "description": "Карточка созданного ключа.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Key"
                },
                "examples": {
                  "config": {
                    "value": {
                      "name": "frontend.banner",
                      "scope": "frontend",
                      "type": "config",
                      "value": null,
                      "updated_at": "2026-11-28T10:00:00Z",
                      "description": "",
                      "created_at": "2026-11-28T10:00:00Z",
                      "created_by": {
                        "id": 42,
                        "login": "admin"
                      },
                      "updated_by": {
                        "id": 42,
                        "login": "admin"
                      },
                      "format": "json"
                    }
                  },
                  "flag": {
                    "value": {
                      "name": "workspace.calendar",
                      "scope": "workspace",
                      "type": "flag",
                      "enabled": false,
                      "rollout_percent": 0,
                      "updated_at": "2026-11-28T10:00:00Z",
                      "description": "",
                      "created_at": "2026-11-28T10:00:00Z",
                      "created_by": {
                        "id": 42,
                        "login": "admin"
                      },
                      "updated_by": {
                        "id": 42,
                        "login": "admin"
                      },
                      "include_users": [],
                      "exclude_users": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/NameTaken"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/IdentityUnavailable"
          }
        },
        "description": "Полное имя начинается с указанной области и точки. Конфиг создаётся со значением null. Флаг создаётся выключенным, с нулевым процентом и пустыми списками.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CreateConfigKey"
                  },
                  {
                    "$ref": "#/components/schemas/CreateFlagKey"
                  }
                ]
              },
              "examples": {
                "config": {
                  "value": {
                    "name": "frontend.banner",
                    "scope": "frontend",
                    "type": "config",
                    "format": "json"
                  }
                },
                "flag": {
                  "value": {
                    "name": "workspace.calendar",
                    "scope": "workspace",
                    "type": "flag"
                  }
                }
              }
            }
          }
        }
      }
    },
