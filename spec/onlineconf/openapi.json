    "/admin/users/resolve": {
      "get": {
        "summary": "Найти пользователя",
        "operationId": "onlineConfResolveUser",
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Пользователь найден.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": 17,
                  "login": "user17"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/IdentityUnavailable"
          }
        },
        "description": "Передайте ровно один параметр: id или login. Поиск по логину выполняется без учёта регистра.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Положительный ID пользователя.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "example": 17
          },
          {
            "name": "login",
            "in": "query",
            "required": false,
            "description": "Логин пользователя. Строка из одних пробельных символов недопустима.",
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "example": "user17"
          }
        ]
      }
    },
    "/api/v1/onlineconf/me": {
      "get": {
        "summary": "Публичные настройки продукта для текущей сессии",
        "description": "Продуктовый, не административный метод: роль onlineconf_admin не нужна. Вызывают доверенные BFF (X-BFF-Key) и Workspace с Bearer пользователя; пользователь определяется по сессии в Identity, user_id и параметр экрана не принимаются. Возвращает только два публичных значения — без правил, процентов, списков пользователей и произвольных ключей.",
        "operationId": "getProductSettings",
        "tags": [
          "product"
        ],
        "responses": {
          "200": {
            "description": "Эффективные значения для пользователя сессии.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSettings"
                },
                "example": {
                  "notebook_max_cells": 500,
                  "notebook_run_all": true
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/ProductForbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/SnapshotUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bffKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-BFF-Key",
        "description": "Общий секрет BFF и OnlineConf."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Пользовательский access-токен с ролью onlineconf_admin."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Scope": {
        "type": "string",
        "enum": [
          "frontend",
          "bff",
          "identity",
          "workspace"
        ]
      },
      "Name": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_]+(\\.[a-zA-Z0-9_]+)+$",
        "description": "Полное имя ключа с префиксом области."
      },
      "JSONValue": {
        "description": "Произвольное JSON-значение, включая объект, массив, строку, число, boolean и null."
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "login"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "login": {
            "type": "string"
          }
        }
      },
      "ConfigKeySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type",
          "updated_at",
          "value"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "config"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "$ref": "#/components/schemas/JSONValue"
          }
        }
      },
      "ConfigKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type",
          "updated_at",
          "value",
          "description",
          "created_at",
          "created_by",
          "updated_by",
          "format"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "config"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "$ref": "#/components/schemas/JSONValue"
          },
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "$ref": "#/components/schemas/User"
          },
          "updated_by": {
            "$ref": "#/components/schemas/User"
          },
          "format": {
            "type": "string",
            "enum": [
              "json"
            ]
          }
        }
      },
      "CreateConfigKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type",
          "format"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "config"
            ]
          },
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          },
          "format": {
            "type": "string",
            "enum": [
              "json"
            ]
          }
        }
      },
      "UpdateConfigKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "value"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          },
          "value": {
            "$ref": "#/components/schemas/JSONValue"
          }
        }
      },
      "FlagKeySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type",
          "updated_at",
          "enabled",
          "rollout_percent"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "flag"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "rollout_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "FlagKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type",
          "updated_at",
          "enabled",
          "rollout_percent",
          "description",
          "created_at",
          "created_by",
          "updated_by",
          "include_users",
          "exclude_users"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "flag"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          },
          "rollout_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "$ref": "#/components/schemas/User"
          },
          "updated_by": {
            "$ref": "#/components/schemas/User"
          },
          "include_users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "exclude_users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "CreateFlagKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope",
          "type"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "type": {
            "type": "string",
            "enum": [
              "flag"
            ]
          },
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          }
        }
      },
      "UpdateFlagKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "enabled",
          "rollout_percent",
          "include_user_ids",
          "exclude_user_ids"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Описание ключа. Пустая строка допустима. Символ NUL запрещён."
          },
          "enabled": {
            "type": "boolean"
          },
          "rollout_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "include_user_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "exclude_user_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        }
      },
      "Key": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ConfigKey"
          },
          {
            "$ref": "#/components/schemas/FlagKey"
          }
        ]
      },
      "KeyList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total_count",
          "scope_count",
          "scopes"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ConfigKeySummary"
                },
                {
                  "$ref": "#/components/schemas/FlagKeySummary"
                }
              ]
            }
          },
          "total_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Число всех ключей до применения фильтров."
          },
          "scope_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Число областей, в которых есть ключи, до применения фильтров."
          },
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scope"
            },
            "description": "Все допустимые области."
          }
        }
      },
      "ProductSettings": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notebook_max_cells",
          "notebook_run_all"
        ],
        "properties": {
          "notebook_max_cells": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Эффективное значение bff.notebook_max_cells, общее для всех. Отсутствие ключа на свежем снимке, неверный тип или значение вне диапазона — 1000."
          },
          "notebook_run_all": {
            "type": "boolean",
            "description": "Решение флага workspace.notebook_run_all для пользователя сессии по правилам #156. Отсутствие ключа на свежем снимке — true."
          }
        }
      }
    },
