                  "message": "internal error"
                }
              }
            }
          },
          "503": {
            "description": "Identity или хранилище OnlineConf недоступны.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "dependency_unavailable",
                  "message": "authorization unavailable"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyValue"
              },
              "examples": {
                "config": {
                  "summary": "config",
                  "value": {
                    "kind": "config",
                    "value": false
                  }
                },
                "flag": {
                  "summary": "flag",
                  "value": {
                    "kind": "flag",
                    "rollout_percent": 100,
                    "include_user_ids": [],
                    "exclude_user_ids": [
                      42
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access-токен пользователя, передаваемый BFF из его сессии."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "validation_error",
              "unauthorized",
              "forbidden",
              "s2s_forbidden",
              "not_found",
              "conflict",
              "internal",
              "dependency_unavailable"
            ]
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "Scope": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$",
        "description": "Потребитель: frontend или имя микросервиса.",
        "examples": [
          "frontend"
        ]
      },
      "Name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
        "description": "Имя ключа, уникальное в scope.",
        "examples": [
          "editor.theme"
        ]
      },
      "ConfigValue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "config"
          },
          "value": {
            "description": "Произвольное JSON-значение: объект, массив, строка, число, булево или null. Тип сохраняется; false, 0 и null — значения, а не отсутствие ключа."
          }
        }
      },
      "FlagValue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "rollout_percent",
          "include_user_ids",
          "exclude_user_ids"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "flag"
          },
          "rollout_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Доля пользователей, для которых флаг включён, от 0 до 100 включительно."
          },
          "include_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Пользователи, для которых флаг включён независимо от процента. Не пересекается с exclude_user_ids."
          },
          "exclude_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Пользователи, для которых флаг выключен независимо от процента."
          }
        }
      },
      "KeyValue": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ConfigValue"
          },
          {
            "$ref": "#/components/schemas/FlagValue"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "config": "#/components/schemas/ConfigValue",
            "flag": "#/components/schemas/FlagValue"
          }
        }
      },
      "ConfigKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "name",
          "kind",
          "value"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "kind": {
            "type": "string",
            "const": "config"
          },
          "value": {
            "description": "Произвольное JSON-значение: объект, массив, строка, число, булево или null. Тип сохраняется; false, 0 и null — значения, а не отсутствие ключа."
          }
        }
      },
      "FlagKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "name",
          "kind",
          "rollout_percent",
          "include_user_ids",
          "exclude_user_ids"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "kind": {
            "type": "string",
            "const": "flag"
          },
          "rollout_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Доля пользователей, для которых флаг включён, от 0 до 100 включительно."
          },
          "include_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Пользователи, для которых флаг включён независимо от процента. Не пересекается с exclude_user_ids."
          },
          "exclude_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "Пользователи, для которых флаг выключен независимо от процента."
          }
        }
      },
      "Key": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ConfigKey"
          },
          {
            "$ref": "#/components/schemas/FlagKey"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "config": "#/components/schemas/ConfigKey",
            "flag": "#/components/schemas/FlagKey"
          }
        }
      },
      "KeySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "name",
          "kind"
        ],
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "config",
              "flag"
            ]
          }
        }
      },
      "KeyList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/KeySummary"
            }
          }
        }
      }
    }
  }
}
