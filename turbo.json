{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "stream",
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            // RELEASE_SHA и CDN_URL задаёт CI для релиза: от них зависит base в сборке клиента
            "env": ["RELEASE_SHA", "CDN_URL", "VITE_STATIC_URL"],
            "outputs": ["dist/**"]
        },
        // админка дописывает onlineconf.html и свои чанки в dist клиента — после его сборки, которая
        // очищает dist. Кеш выключен: turbo хранит выходы задачи только внутри её пакета
        "@cdd/onlineconf-admin#build": {
            "dependsOn": ["^build", "@cdd/client#build"],
            "env": ["RELEASE_SHA", "CDN_URL"],
            "cache": false
        },
        "lint": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        // turbo watch перезапускает BFF при изменении его файлов и пакетов, которые он импортирует
        // (@cdd/schemas): bun --watch пакеты вне apps/bff на Windows не отслеживает. Без
        // зависимости от ^typecheck изменение в @cdd/schemas BFF не перезапускает
        "@cdd/bff#dev": {
            "dependsOn": ["^typecheck"],
            "cache": false,
            "persistent": true,
            "interruptible": true,
            "passThroughEnv": [
                "IDENTITY_API_URL",
                "WORKSPACE_API_URL",
                "GO_API_TLS_*",
                "*_API_URL_TLS_SERVER_NAME",
                "BFF_KEY"
            ]
        },
        "//#lint:scripts": {
            "inputs": ["scripts/**", "oxlint.config.ts"]
        },
        "//#typecheck:scripts": {
            "inputs": ["scripts/**"]
        }
    }
}
